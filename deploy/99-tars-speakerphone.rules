# Starts TARS when a USB sound card (the speakerphone) is plugged in. With none, TARS exits and stays stopped
# instead of restarting every few seconds (exit 69, RestartPreventExitStatus), so this is what brings it back.
# Any USB sound card counts; starting TARS when it's already running does nothing.
#
# And lets TARS's user (the input group) use the speakerphone's own mute through its hidraw device, root's alone
# otherwise (speakerphone.py, docs/home.md#buttons): only the speakerphones listed here, by their USB ids, the
# Anker PowerConf's first. Another: its ids are in `lsusb`, as idVendor:idProduct.
#
# install-pi.sh installs it:
#
#   sudo cp deploy/99-tars-speakerphone.rules /etc/udev/rules.d/ && sudo udevadm control --reload
ACTION=="add", SUBSYSTEM=="sound", KERNEL=="card*", SUBSYSTEMS=="usb", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}+="voice-assistant.service"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="291a", ATTRS{idProduct}=="3301", GROUP="input", MODE="0660"
