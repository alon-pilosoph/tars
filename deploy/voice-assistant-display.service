# systemd *user* service for the virtual screen TARS's browser draws to on the Pi (docs/browser.md). Pi OS Lite has
# no screen of its own, and Chromium runs as a normal window there rather than headless, which some sites refuse.
# Nothing shows it: TARS signs in to sites itself, from its vault (browser/vault.py).
#
#   cp deploy/voice-assistant-display.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now voice-assistant-display
#
# install-pi.sh does all of this. The size is TARS's browser window's (browser/chrome.py WINDOW), with room.

[Unit]
Description=TARS browser's virtual screen

[Service]
ExecStart=/usr/bin/Xvfb :99 -screen 0 1280x1000x24 -nolisten tcp
# Sandboxed: it writes only to /tmp (its lock and socket file), with no home (so no /run/user and no user D-Bus) and
# no Docker. The browser, in Telegram's /tmp of its own, can't see that socket file: it reaches the screen over the
# abstract socket @/tmp/.X11-unix/X99, which belongs to the network namespace, so PrivateNetwork= on either unit
# would cut it off.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/tmp
RestrictAddressFamilies=AF_UNIX
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock
LockPersonality=yes
SystemCallArchitectures=native
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
PrivateDevices=yes
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
