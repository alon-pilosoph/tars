# systemd *user* service for TARS on Telegram ([telegram] in config.toml, docs/telegram.md). Its own process, like the
# web UI: a problem with Telegram never takes the voice down. deploy/install-pi.sh installs it when [telegram] is on.
#
#   cp deploy/voice-assistant-telegram.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now voice-assistant-telegram
#
#   journalctl --user-unit voice-assistant-telegram -f    # follow the logs (a new person's chat id shows up here)
#
# It only reaches out to Telegram, asking for new messages: nothing is opened to the internet.

[Unit]
Description=TARS on Telegram
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/voice-assistant
ExecStart=%h/.local/bin/uv run --frozen --all-extras voice-assistant --telegram
Environment=PYTHONUNBUFFERED=1
# Sandboxed (docs/security.md#the-services-on-the-machine): the system and home read-only but TARS's own folder, its
# caches (the browser's vault and Sprite keys) and ~/.sprites (the sprite command's login, for the browser's link), a
# /tmp of its own, files only its user can read, no new privileges (no sudo), only local, IP and netlink sockets (glibc
# asks the kernel for the machine's addresses over netlink to order a name's answers).
# Keeps the user manager's D-Bus (a changed setting restarts TARS, a tap on Install starts the updater) and Docker
# (Home Assistant's setup history runs git in its container): docs/security.md says what that leaves open.
# Not yet the kernel, syscall or capability limits the others have: Chromium's sandbox needed them when errands ran
# here; now that they run on the Sprite they could be added, once tried on the Pi.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/voice-assistant -%h/.cache -%h/.sprites
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077
Restart=always
RestartSec=10
# 78 (EX_CONFIG): a mistake in config.toml, a missing key, or a token Telegram refused. Restarting won't fix it.
RestartPreventExitStatus=78

[Install]
WantedBy=default.target
