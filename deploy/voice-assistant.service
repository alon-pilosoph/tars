# systemd *user* service: starts TARS at boot and restarts it if it exits (e.g. the
# microphone stopped working). With no speakerphone it stays stopped, and plugging it in starts
# it (99-tars-speakerphone.rules). A user service shares the login session's PipeWire audio.
#
#   mkdir -p ~/.config/systemd/user
#   cp deploy/voice-assistant.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now voice-assistant
#   sudo loginctl enable-linger $USER    # start at boot, without logging in
#   sudo cp deploy/99-tars-speakerphone.rules /etc/udev/rules.d/ && sudo udevadm control --reload
#
#   journalctl --user-unit voice-assistant -f    # follow the logs

[Unit]
Description=TARS voice assistant
After=pipewire.service

[Service]
# Assumes the repo is cloned to ~/voice-assistant and uv is installed in ~/.local/bin.
WorkingDirectory=%h/voice-assistant
ExecStart=%h/.local/bin/uv run --frozen --all-extras voice-assistant
Environment=PYTHONUNBUFFERED=1
# Sandboxed (docs/security.md#the-pi): the system and home read-only but TARS's own folder (and caches), a /tmp of
# its own, no new privileges (no sudo), only local, IPv4 and IPv6 sockets. Checked on the Pi with --check inside it.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/voice-assistant -%h/.cache -%h/.config
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
SystemCallFilter=@system-service
# A call outside the filter fails with an error rather than killing TARS.
SystemCallErrorNumber=EPERM
Restart=always
RestartSec=3
# 78 (EX_CONFIG): a mistake in config.toml or a missing API key. Restarting won't fix it; see the logs.
# 69 (EX_UNAVAILABLE): no speakerphone. Plugging it in starts TARS again (99-tars-speakerphone.rules).
RestartPreventExitStatus=78 69

[Install]
WantedBy=default.target
