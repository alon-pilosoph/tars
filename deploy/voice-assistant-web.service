# systemd *user* service for the web UI. It only reads and edits the event log (voice_data/events), so it runs as
# its own process: a crash in either never takes the other down.
#
#   mkdir -p ~/.config/systemd/user
#   cp deploy/voice-assistant-web.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now voice-assistant-web
#   sudo loginctl enable-linger $USER    # start at boot, without logging in (once, for all of TARS's services)
#
#   journalctl --user-unit voice-assistant-web -f    # follow the logs
#
# Then open http://<pi-name>.local:8080 from a phone or laptop on the home network. There are no accounts:
# anyone on the network can open it, so don't forward the port to the internet (use Tailscale to reach it away
# from home). It only answers to home-network names (see [web] in config.toml).

[Unit]
Description=TARS web UI

[Service]
WorkingDirectory=%h/voice-assistant
ExecStart=%h/.local/bin/uv run --frozen --all-extras voice-assistant --web --host 0.0.0.0 --port 8080
Environment=PYTHONUNBUFFERED=1
# Sandboxed (docs/security.md#the-pi): the system and home read-only but TARS's own folder (and caches), a /tmp of
# its own, no new privileges (no sudo), only local, IPv4 and IPv6 sockets. Checked on the Pi with --check inside it.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/voice-assistant -%h/.cache -%h/.config
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
SystemCallFilter=@system-service
# A call outside the filter fails with an error rather than killing TARS.
SystemCallErrorNumber=EPERM
PrivateDevices=yes
Restart=always
RestartSec=3
# 78 (EX_CONFIG): a mistake in config.toml or a missing API key. Restarting won't fix it; see the logs.
RestartPreventExitStatus=78

[Install]
WantedBy=default.target
