.env
# This machine's own settings, over config.toml (config.py LOCAL_CONFIG)
config.local.toml
.venv/
__pycache__/
*.pyc
*.wav
voice_data/
# Models download on first use and models/personal/ is learned from the owner's voice: only the generic pair, the
# optional large pair and their license are committed.
models/*
!models/generic/
!models/generic-large/
!models/LICENSE.md

.DS_Store
webui/node_modules/

# The built "How TARS works" page (webui: npm run site)
site/dist/

# Scenario eval transcripts (python -m evals): kept locally, not committed
evals/runs/

# What tinytuya's wizard writes where it runs (examples/my_house): the Tuya devices' local keys and the cloud secret
devices.json
tinytuya.json
snapshot.json
tuya-raw.json
