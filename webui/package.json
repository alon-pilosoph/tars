{
  "name": "tars-webui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write src checks *.ts package.json tsconfig*.json .oxlintrc.json ../.github/workflows",
    "format:check": "prettier --check src checks *.ts package.json tsconfig*.json .oxlintrc.json ../.github/workflows",
    "e2e": "npm run build && playwright test -c checks/e2e.config.ts",
    "screenshots": "npm run build && playwright test -c checks/screenshots.config.ts",
    "visual": "npm run build && playwright test -c checks/visual.config.ts",
    "visual:update": "npm run build && playwright test -c checks/visual.config.ts --update-snapshots"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.83.0",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
