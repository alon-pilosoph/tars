# Copy to .env and fill in. Only .env is read; keys in your shell are ignored.
# Always needed: OpenAI's model answers what needs the web or the TARS page (or everything, without Cerebras), and
# transcribes the recording when streaming speech to text fails; platform.openai.com
OPENAI_API_KEY=
# [stt] provider = "deepgram" or "flux", or [tts] provider = "deepgram"; console.deepgram.com
DEEPGRAM_API_KEY=
# [llm] cerebras_model, the quick brain; cloud.cerebras.ai
CEREBRAS_API_KEY=
